---
import { ADDRESS_QUERY } from '../lib/site';

// Embed por dirección, no por place ID: el pin de Google estaba corrido ~240 m.
const mapSrc = `https://maps.google.com/maps?q=${encodeURIComponent(ADDRESS_QUERY)}&z=17&output=embed&hl=es`;
---

<iframe
  src={mapSrc}
  title="Mapa con la ubicación de La Pulpería MG"
  width="600"
  height="450"
  class="h-[50vh] w-full rounded-2xl border border-[#B45427]/50 lg:h-full lg:min-h-[420px]"
  style="border:0;"
  allowfullscreen=""
  loading="lazy"
  referrerpolicy="strict-origin-when-cross-origin"
></iframe>
