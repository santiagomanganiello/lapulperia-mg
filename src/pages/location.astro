---
import Layout from "../layouts/Layout.astro";
import Location from "../components/Location.astro";
import Hours from "../components/Hours.astro";
import { SITE, ADDRESS_LINE, MAPS_URL, DIRECTIONS_URL, WHATSAPP_URL } from "../lib/site";
---

<Layout
  title="Ubicación"
  description="La Pulpería MG está en Av. Dardo Rocha 396, Monte Grande. Horarios, mapa y cómo llegar."
>
  <div class="mx-auto w-full max-w-5xl px-4 py-10 sm:px-8">
    <h1 class="text-4xl text-[#FBE9A5] sm:text-5xl">Dónde estamos</h1>
    <p class="mt-2 text-2xl text-[#FBE9A5]/80">{ADDRESS_LINE}</p>

    <div class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-2">
      <a
        href={DIRECTIONS_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-lg bg-[#31572A] px-4 py-2 text-lg text-[#FBE9A5] transition-colors duration-300 hover:bg-[#3f6b3f]"
      >
        Cómo llegar →
      </a>
      <a
        href={MAPS_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="text-lg text-[#FBE9A5]/70 underline-offset-4 transition-colors hover:text-[#FBE9A5] hover:underline"
      >
        Ver en Google Maps
      </a>
    </div>

    <div class="mt-8 grid gap-6 lg:grid-cols-[2fr_1fr]">
      <Location />

      <aside class="flex flex-col gap-6 rounded-2xl border border-[#B45427]/50 bg-[#770a15] p-5">
        <div class="flex flex-col gap-2">
          <h2 class="text-2xl text-[#FBE9A5]">Horarios</h2>
          <Hours />
        </div>

        <div class="flex flex-col gap-2 border-t border-[#B45427]/30 pt-5">
          <h2 class="text-2xl text-[#FBE9A5]">Pedidos</h2>
          <p class="text-lg text-[#FBE9A5]/70">Delivery por WhatsApp al {SITE.whatsapp.label}.</p>
          <a
            href={WHATSAPP_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex w-fit items-center gap-2 rounded-lg bg-[#31572A] px-4 py-2 text-lg text-[#FBE9A5] transition-colors duration-300 hover:bg-[#3f6b3f]"
          >
            <span aria-hidden="true">💬</span>
            Pedir por WhatsApp
          </a>
        </div>
      </aside>
    </div>
  </div>
</Layout>
