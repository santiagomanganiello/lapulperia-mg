---
export const prerender = false;

import { supabase, isSupabaseConfigured, supabaseConfigError } from "../lib/supabase";
import { formatEventDate, relativeDayLabel } from "../lib/events";
import Layout from "../layouts/Layout.astro";

type EventRow = {
  id: string;
  title: string;
  artist: string | null;
  description: string | null;
  event_date: string;
  image_url: string | null;
  ticket_info: string | null;
  published: boolean;
};

const { data, error } = isSupabaseConfigured
  ? await supabase
      .from("events")
      .select("id, title, artist, description, event_date, image_url, ticket_info, published")
      .eq("published", true)
      .gte("event_date", new Date().toISOString())
      .order("event_date", { ascending: true })
  : { data: null, error: { message: supabaseConfigError } };

const events = (data as EventRow[] | null) ?? [];

const eventsWithMeta = events.map((event) => ({
  ...event,
  ...formatEventDate(event.event_date),
  relative: relativeDayLabel(event.event_date),
}));
---

<Layout
  title="Eventos"
  description="Agenda de eventos y música en vivo en La Pulpería MG, Monte Grande."
>
  <div class="flex-1 px-4 py-8 sm:px-8">
    <h1 class="mb-6 text-center text-3xl text-[#FBE9A5] sm:text-4xl">Próximos eventos</h1>

    {error && (
      <p class="mx-auto mb-6 max-w-xl rounded-lg border border-red-400/60 bg-red-950/40 px-4 py-3 text-lg text-red-200">
        No pudimos cargar la agenda en este momento. Probá de nuevo en unos minutos.
        {import.meta.env.DEV && supabaseConfigError && (
          <span class="mt-2 block text-base text-red-200/80">{supabaseConfigError}</span>
        )}
      </p>
    )}

    {eventsWithMeta.length > 0 ? (
      <div class="mx-auto grid max-w-6xl grid-cols-1 gap-6 sm:grid-cols-2 xl:grid-cols-3">
        {eventsWithMeta.map((event) => (
          <article class="flex flex-col overflow-hidden rounded-2xl border border-[#B45427]/50 bg-[#770a15]">
            {event.image_url ? (
              <img
                src={event.image_url}
                alt={`Flyer de ${event.title}`}
                loading="lazy"
                class="h-100 w-full border-b border-[#B45427]/40 object-cover"
              />
            ) : (
              <div class="flex h-64 w-full items-center justify-center border-b border-dashed border-[#B45427]/50 bg-black/20 text-6xl text-[#FBE9A5]/30">
                🎸
              </div>
            )}

            <div class="flex flex-1 flex-col gap-3 p-4">
              <div class="flex flex-wrap items-center gap-2">
                <h2 class="text-2xl text-[#FBE9A5]">{event.title}</h2>
                {event.relative && (
                  <span class="rounded-full bg-[#31572A] px-2.5 py-0.5 text-sm text-[#FBE9A5]">
                    {event.relative}
                  </span>
                )}
              </div>

              {event.artist && (
                <p class="text-lg text-[#FBE9A5]/85">
                  <span aria-hidden="true">🎤</span> {event.artist}
                </p>
              )}

              <p class="text-lg text-[#FBE9A5]/80">
                <span aria-hidden="true">📅</span> {event.fecha}
                {event.hora && <span class="text-[#FBE9A5]/60"> · {event.hora}</span>}
              </p>

              {event.description && (
                <p class="whitespace-pre-line text-lg text-[#FBE9A5]/70">{event.description}</p>
              )}

              {event.ticket_info && (
                <p class="rounded-lg border border-[#31572A] bg-[#31572A]/30 px-3 py-2 text-lg text-[#FBE9A5]/85">
                  <span aria-hidden="true">🎟️</span> {event.ticket_info}
                </p>
              )}

              <a
                href={`/eventos/${event.id}.ics`}
                class="mt-auto inline-flex w-fit items-center gap-2 rounded-lg border border-[#B45427]/60 px-3 py-2 text-lg text-[#FBE9A5]/80 transition-colors hover:bg-[#31572A]/40 hover:text-[#FBE9A5]"
              >
                <span aria-hidden="true">📆</span>
                Agregar al calendario
              </a>
            </div>
          </article>
        ))}
      </div>
    ) : (
      !error && (
        <div class="mx-auto max-w-xl rounded-2xl border border-dashed border-[#B45427]/60 bg-[#770a15]/60 px-6 py-10 text-center">
          <p class="text-2xl text-[#FBE9A5]">No hay fechas programadas por ahora.</p>
          <p class="mt-2 text-lg text-[#FBE9A5]/70">
            Seguinos para enterarte de las próximas noches.
          </p>
        </div>
      )
    )}
  </div>
</Layout>
