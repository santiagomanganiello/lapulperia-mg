# Editores: estas reglas se aplican al guardar y mantienen el repo consistente.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# En Markdown los dos espacios finales son un salto de línea intencional.
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2
