---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página no encontrada">
  <div class="flex flex-1 flex-col items-center justify-center px-4 py-20 text-center">
    <p class="text-7xl leading-none text-[#B45427] sm:text-8xl">404</p>

    <h1 class="mt-4 text-4xl text-[#FBE9A5] sm:text-5xl">No encontramos esa página</h1>

    <p class="mt-3 max-w-lg text-xl text-[#FBE9A5]/70">
      Puede que el link esté mal escrito o que la página ya no exista.
    </p>

    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a
        href="/"
        class="rounded-lg bg-[#31572A] px-6 py-3 text-xl text-[#FBE9A5] transition-colors duration-300 hover:bg-[#3f6b3f]"
      >
        Volver al inicio
      </a>
      <a
        href="/eventos"
        class="rounded-lg border border-[#B45427]/60 px-6 py-3 text-xl text-[#FBE9A5] transition-colors duration-300 hover:bg-[#770a15]"
      >
        Ver eventos
      </a>
    </div>
  </div>
</Layout>
