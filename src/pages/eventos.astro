---
export const prerender = false;

import { supabase } from "../lib/supabase";
import { formatEventDate } from "../lib/events";
import Layout from "../layouts/Layout.astro";

type EventRow = {
  id: string;
  title: string;
  artist: string | null;
  description: string | null;
  event_date: string;
  image_url: string | null;
  ticket_info: string | null;
  published: boolean;
};

const { data, error } = await supabase
  .from("events")
  .select("id, title, artist, description, event_date, image_url, ticket_info, published")
  .eq("published", true)
  .gte("event_date", new Date().toISOString())
  .order("event_date", { ascending: true });

const events = (data as EventRow[] | null) ?? [];

const now = Date.now();
const eventsWithMeta = events.map((event) => ({
  ...event,
  ...formatEventDate(event.event_date),
  isPast: new Date(event.event_date).getTime() < now,
}));
---

<Layout title="Eventos en La Pulpería MG">
  <main class="flex-1 px-4 py-8 sm:px-8">
    <h1 class="mb-6 text-center text-3xl text-[#FBE9A5] sm:text-4xl">Próximos eventos</h1>

    {error && (
      <p class="mx-auto mb-6 max-w-xl rounded-lg border border-red-400/60 bg-red-950/40 px-4 py-3 text-lg text-red-200">
        Error al cargar los eventos: {error.message}
      </p>
    )}

    {eventsWithMeta.length > 0 ? (
      <div class="mx-auto grid max-w-6xl grid-cols-1 gap-6 sm:grid-cols-2 xl:grid-cols-3">
        {eventsWithMeta.map((event) => (
          <article
            class:list={[
              "flex flex-col overflow-hidden rounded-2xl border border-[#B45427]/50 bg-[#770a15]",
              event.isPast && "opacity-60",
            ]}
          >
            {event.image_url ? (
              <img
                src={event.image_url}
                alt={`Flyer de ${event.title}`}
                loading="lazy"
                class="h-100 w-full border-b border-[#B45427]/40 object-cover"
              />
            ) : (
              <div class="flex h-64 w-full items-center justify-center border-b border-dashed border-[#B45427]/50 bg-black/20 text-6xl text-[#FBE9A5]/30">
                🎸
              </div>
            )}

            <div class="flex flex-1 flex-col gap-3 p-4">
              <div class="flex flex-wrap items-center gap-2">
                <h2 class="text-2xl text-[#FBE9A5]">{event.title}</h2>
                {!event.published && (
                  <span class="rounded-full bg-[#B45427]/40 px-2.5 py-0.5 text-sm text-[#FBE9A5]">
                    Borrador
                  </span>
                )}
                {event.isPast && (
                  <span class="rounded-full bg-black/30 px-2.5 py-0.5 text-sm text-[#FBE9A5]/70">
                    Pasado
                  </span>
                )}
              </div>

              {event.artist && (
                <p class="text-lg text-[#FBE9A5]/85">
                  <span aria-hidden="true">🎤</span> {event.artist}
                </p>
              )}

              <p class="text-lg text-[#FBE9A5]/80">
                <span aria-hidden="true">📅</span> {event.fecha}
                {event.hora && <span class="text-[#FBE9A5]/60"> · {event.hora}</span>}
              </p>

              {event.description && (
                <p class="whitespace-pre-line text-lg text-[#FBE9A5]/70">{event.description}</p>
              )}

              {event.ticket_info && (
                <p class="mt-auto rounded-lg border border-[#31572A] bg-[#31572A]/30 px-3 py-2 text-lg text-[#FBE9A5]/85">
                  <span aria-hidden="true">🎟️</span> {event.ticket_info}
                </p>
              )}
            </div>
          </article>
        ))}
      </div>
    ) : (
      !error && <p class="text-center text-xl text-[#FBE9A5]/70">No hay eventos cargados todavía.</p>
    )}
  </main>
</Layout>
